<Window x:Class="ClaudeZhInput.StatusBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude 输入法状态栏" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" Focusable="False"
        FontFamily="Noto Sans SC, Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ButtonCorner}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Frame" BorderThickness="1" Padding="6" CornerRadius="10">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="Grip" Width="28" Margin="0,0,4,0" Background="Transparent"
                    Cursor="SizeAll" ToolTip="Claude 输入法 · 拖动调整位置"
                    MouseLeftButtonDown="DragStarted" MouseMove="DragMoved" MouseLeftButtonUp="DragFinished">
                <TextBlock Text="C" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Button x:Name="ChineseButton" Content="普通中文" Style="{StaticResource BarButton}"
                    AutomationProperties.AutomationId="ToolbarChinese" Click="ChineseClicked"
                    ToolTip="拼音选字后直接输入中文 · Ctrl+Shift+M 切换模式"/>
            <Button x:Name="EnglishButton" Content="整句英文" Style="{StaticResource BarButton}"
                    AutomationProperties.AutomationId="ToolbarEnglish" Click="EnglishClicked"
                    ToolTip="先输入完整中文，句号、问号、叹号或回车结束后自动转为英文"/>
            <Border Width="1" Height="20" Margin="8,0" Background="{DynamicResource Stroke}"/>
            <TextBlock x:Name="Status" MinWidth="156" Text="等待句末" VerticalAlignment="Center"
                       Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="CommandsButton" Content="指令" Style="{StaticResource BarButton}"
                    AutomationProperties.AutomationId="ToolbarCommands" Click="CommandsClicked"/>
            <Button Content="皮肤" Style="{StaticResource BarButton}" Click="SkinClicked"
                    AutomationProperties.AutomationId="ToolbarSkin" ToolTip="切换状态栏、候选框与设置面板的皮肤"/>
            <Button Content="设置" Style="{StaticResource BarButton}" Click="SettingsClicked"
                    AutomationProperties.AutomationId="ToolbarSettings" ToolTip="打开输入法设置"/>
            <Button Content="原文" Style="{StaticResource BarButton}" Click="ReviewClicked"
                    AutomationProperties.AutomationId="ToolbarReview" ToolTip="找回最近的中文原文，也可复制英文"/>
        </StackPanel>
    </Border>
</Window>
