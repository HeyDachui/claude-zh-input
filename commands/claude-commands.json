{
  "schemaVersion": 1,
  "catalogVersion": "2026-10-08",
  "description": "Claude Code 常用斜杠命令中文输入库。候选只填入命令文本，不自动执行；同时可索引用户自己的 .claude/commands 与 .claude/skills 元数据。",
  "verification": {
    "officialDocsCheckedOn": "2026-10-08",
    "localVersion": "2.1.292 (Claude Code)",
    "localHelpCommand": "claude --help",
    "localHelpScope": "本机 --help 核对 CLI 启动选项和子命令；斜杠命令清单以官方 commands 页面为准。未执行任何配置、删除、网络或会话命令。"
  },
  "trigger": {
    "prefix": ";;",
    "keyGesture": "Ctrl+;",
    "requiresCompositionStart": true,
    "consumePrefixWhenOpened": true,
    "candidateOnly": true,
    "notes": ";; 只在当前组合文本开头触发，普通文字中出现的分号不受影响；Ctrl+; 可直接打开菜单。候选选择后只填入 /command，等待用户自行编辑和提交。"
  },
  "sources": [
