<Window x:Class="ClaudeZhInput.Commands.Wpf.CommandPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude 常用指令"
        Width="720"
        Height="560"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource CommandPickerBackgroundBrush}"
        Foreground="{DynamicResource CommandPickerForegroundBrush}"
        FontFamily="Noto Sans SC,Microsoft YaHei UI"
        FontSize="14"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="CommandPickerBackgroundBrush" Color="#10151B" />
        <SolidColorBrush x:Key="CommandPickerSurfaceBrush" Color="#18212A" />
        <SolidColorBrush x:Key="CommandPickerInputBrush" Color="#121A21" />
        <SolidColorBrush x:Key="CommandPickerForegroundBrush" Color="#F2F6F8" />
        <SolidColorBrush x:Key="CommandPickerSecondaryForegroundBrush" Color="#AAB9C5" />
        <SolidColorBrush x:Key="CommandPickerMutedForegroundBrush" Color="#7F929F" />
        <SolidColorBrush x:Key="CommandPickerAccentBrush" Color="#63D9A1" />
        <SolidColorBrush x:Key="CommandPickerSelectionBrush" Color="#213C3A" />
        <SolidColorBrush x:Key="CommandPickerHoverBrush" Color="#20303A" />
        <SolidColorBrush x:Key="CommandPickerBorderBrush" Color="#30414D" />
        <CornerRadius x:Key="CommandPickerCornerRadius">10</CornerRadius>
        <Thickness x:Key="CommandPickerControlBorderThickness">1</Thickness>

        <Style x:Key="PickerButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource CommandPickerForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource CommandPickerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CommandPickerBorderBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource CommandPickerControlBorderThickness}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CommandPickerCornerRadius}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CommandPickerHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource CommandPickerAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource CommandPickerAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{DynamicResource CommandPickerSurfaceBrush}"
                                BorderBrush="{DynamicResource CommandPickerBorderBrush}"
                                BorderThickness="{DynamicResource CommandPickerControlBorderThickness}"
                                CornerRadius="{DynamicResource CommandPickerCornerRadius}"
                                Padding="14,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CommandPickerHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CommandPickerSelectionBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource CommandPickerAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Claude 常用指令"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CommandPickerForegroundBrush}" />
                <TextBlock Text="输入中文、拼音、缩写或英文筛选"
                           Margin="0,3,0,0"
                           Foreground="{DynamicResource CommandPickerSecondaryForegroundBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="取消"
                    Click="CancelButton_Click"
                    Style="{StaticResource PickerButtonStyle}"
                    VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{DynamicResource CommandPickerInputBrush}"
                    BorderBrush="{DynamicResource CommandPickerBorderBrush}"
                    BorderThickness="{DynamicResource CommandPickerControlBorderThickness}"
                    CornerRadius="{DynamicResource CommandPickerCornerRadius}"
                    Padding="12,2"
                    Margin="0,0,10,0">
                <TextBox x:Name="SearchBox"
                         TextChanged="SearchBox_TextChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource CommandPickerForegroundBrush}"
                         CaretBrush="{DynamicResource CommandPickerAccentBrush}"
                         Padding="0,8"
                         ToolTip="中文、拼音、缩写或 /command" />
            </Border>
            <Border Grid.Column="1"
                    Background="{DynamicResource CommandPickerInputBrush}"
                    BorderBrush="{DynamicResource CommandPickerBorderBrush}"
                    BorderThickness="{DynamicResource CommandPickerControlBorderThickness}"
                    CornerRadius="{DynamicResource CommandPickerCornerRadius}"
                    Padding="4,0">
                <ComboBox x:Name="CategoryBox"
                          ItemsSource="{Binding Categories}"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="CategoryBox_SelectionChanged"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{DynamicResource CommandPickerForegroundBrush}"
                          Padding="7,5" />
            </Border>
        </Grid>

        <ListBox Grid.Row="2"
                 x:Name="CommandList"
                 ItemsSource="{Binding VisibleCommands}"
                 SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource PickerListItemStyle}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 MouseDoubleClick="CommandList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Command}"
                                   FontFamily="Consolas,Cascadia Mono"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource CommandPickerAccentBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ChineseName}"
                                   Margin="12,0,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource CommandPickerForegroundBrush}" />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Usage}"
                                   Margin="0,5,0,0"
                                   FontFamily="Consolas,Cascadia Mono"
                                   Foreground="{DynamicResource CommandPickerSecondaryForegroundBrush}" />
                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Parameters}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource CommandPickerMutedForegroundBrush}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="↑ ↓ 选择　Enter 填入　Esc 取消"
                       Foreground="{DynamicResource CommandPickerMutedForegroundBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding VisibleCommands.Count, StringFormat={}共 {0} 条}"
                       Foreground="{DynamicResource CommandPickerMutedForegroundBrush}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
